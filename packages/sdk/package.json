{
  "name": "@catalyst/sdk",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target browser --minify --sourcemap=external",
    "dev": "bun build ./src/index.ts --outdir ./dist --target browser --watch"
  }
}
