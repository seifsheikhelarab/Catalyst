{
  "name": "catalyst",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "bun build",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "start": "bun scripts/start-all.ts",
    "ingest": "bun run --cwd services/ingest-service src/index.ts",
    "validate-enrich": "bun run --cwd services/validate-enrich-service src/index.ts",
    "stream": "bun run --cwd services/stream-processor-service src/index.ts",
    "management": "bun run --cwd services/management-service src/index.ts",
    "gateway": "bun run --cwd services/api-gateway src/index.ts",
    "query-api": "bun run --cwd services/query-api-service src/index.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/supertest": "^7.2.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
