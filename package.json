{
  "name": "catalyst",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "bun build",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "start": "bun scripts/start-all.ts",
    "ingest": "bun run --cwd services/ingest-service src/index.ts",
    "validate": "bun run --cwd services/validation-service src/index.ts",
    "enrich": "bun run --cwd services/enrichment-service src/index.ts",
    "raw-storage": "bun run --cwd services/raw-storage-service src/index.ts",
    "stream": "bun run --cwd services/stream-processor-service src/index.ts",
    "project": "bun run --cwd services/project-service src/index.ts",
    "auth": "bun run --cwd services/auth-service src/index.ts",
    "gateway": "bun run --cwd services/api-gateway src/index.ts",
    "query-api": "bun run --cwd services/query-api-service src/index.ts",
    "live": "bun run --cwd services/websocket-service src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "prom-client": "^15.1.3"
  }
}
