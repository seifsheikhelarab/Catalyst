{
  "title": "Catalyst Pipeline Overview",
  "uid": "catalyst-pipeline",
  "version": 1,
  "tags": ["catalyst"],
  "schemaVersion": 39,
  "timezone": "utc",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "title": "Events Ingest Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(ingest_events_received_total[1m])",
          "legendFormat": "received"
        },
        {
          "expr": "rate(ingest_events_deduped_total[1m])",
          "legendFormat": "deduped"
        }
      ]
    },
    {
      "title": "Events Validated vs Rejected",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "rate(validation_events_valid_total[1m])",
          "legendFormat": "valid"
        },
        {
          "expr": "rate(validation_events_rejected_total[1m])",
          "legendFormat": "rejected"
        }
      ]
    },
    {
      "title": "Enrichment Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(enrichment_events_processed_total[1m])",
          "legendFormat": "enriched"
        }
      ]
    },
    {
      "title": "ClickHouse Storage Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "rate(raw_storage_batches_inserted_total[1m])",
          "legendFormat": "batches/s"
        },
        {
          "expr": "rate(raw_storage_events_stored_total[1m])",
          "legendFormat": "events/s"
        }
      ]
    },
    {
      "title": "Stream Processing Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(stream_events_processed_total[1m])",
          "legendFormat": "events/s"
        },
        {
          "expr": "rate(stream_rollups_flushed_total[1m])",
          "legendFormat": "rollups/s"
        }
      ]
    },
    {
      "title": "Processing Lag (P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(stream_processing_lag_ms_bucket[5m]))",
          "legendFormat": "stream processor"
        }
      ]
    },
    {
      "title": "Kafka Publish Latency (P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(ingest_kafka_publish_latency_ms_bucket[5m]))",
          "legendFormat": "ingest kafka"
        }
      ]
    },
    {
      "title": "Insert Duration (P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(raw_storage_insert_duration_ms_bucket[5m]))",
          "legendFormat": "clickhouse insert"
        }
      ]
    },
    {
      "title": "Query API Rate & Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(query_api_requests_total[1m])",
          "legendFormat": "requests/s"
        },
        {
          "expr": "rate(query_api_cache_hits_total[1m]) / rate(query_api_requests_total[1m])",
          "legendFormat": "cache hit ratio"
        }
      ]
    },
    {
      "title": "Query Duration (P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(query_api_duration_ms_bucket[5m]))",
          "legendFormat": "query api"
        }
      ]
    },
    {
      "title": "WebSocket Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(ws_connections_total[1m])",
          "legendFormat": "new conns/s"
        }
      ]
    },
    {
      "title": "Gateway Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "targets": [
        {
          "expr": "rate(gateway_requests_total[1m])",
          "legendFormat": "requests/s"
        },
        {
          "expr": "rate(gateway_ws_connections_total[1m])",
          "legendFormat": "ws conns/s"
        }
      ]
    }
  ]
}
